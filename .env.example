# Copy to .env.local and fill in. Required:
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
JWT_SECRET=replace-with-a-long-random-string   # e.g. `openssl rand -base64 48`

# Optional:
MONGODB_DB=relinxr
IPINFO_API_TOKEN=                    # enables per-country click stats
NEXT_PUBLIC_SHORT_DOMAIN=rld.bio     # host shown for short links
NEXT_PUBLIC_SITE_URL=https://rld.bio # used for OG metadata
MONGOOSE_DEBUG=false
